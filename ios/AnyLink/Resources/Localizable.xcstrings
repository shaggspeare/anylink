      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصق أي شيء.\nونحن نقرأ الباقي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
