    "In Safari, tap Share, scroll the app row, tap More and pin AnyLink." : {
      "comment" : "A tip to share the app.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في Safari، اضغط على مشاركة، ومرّر صف التطبيقات، واضغط على المزيد، ثم ثبّت AnyLink."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe in Safari auf „Teilen“, scrolle durch die App-Reihe, tippe auf „Mehr“ und hefte AnyLink an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Safari, toca Compartir, desliza la fila de apps, toca Más y fija AnyLink."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans Safari, touche Partager, fais défiler la rangée d’apps, touche Plus et épingle AnyLink."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
