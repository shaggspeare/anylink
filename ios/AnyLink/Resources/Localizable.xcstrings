    "Everything has a home. New links will land here again until you sort them." : {
      "comment" : "A description of the functionality of the Unsorted tab.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لكل شيء مكانه. ستصل الروابط الجديدة إلى هنا مجددًا حتى تفرزها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles hat seinen Platz. Neue Links landen wieder hier, bis du sie sortierst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo tiene su lugar. Los enlaces nuevos volverán a llegar aquí hasta que los ordenes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout est rangé. Les nouveaux liens arriveront ici jusqu’à ce que tu les tries."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semuanya sudah punya tempat. Link baru akan masuk ke sini lagi sampai kamu mengurutkannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni cosa ha il suo posto. I nuovi link arriveranno di nuovo qui finché non li smisti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべて整理できました。新しいリンクは整理するまで、またここに届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모두 정리되었습니다. 새 링크는 정리할 때까지 다시 여기로 들어옵니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko ma swoje miejsce. Nowe linki znów będą tu trafiać, dopóki ich nie posortujesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo tem seu lugar. Novos links voltarão a chegar aqui até você organizá-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У всего есть место. Новые ссылки снова будут попадать сюда, пока вы их не разберете."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усе на своїх місцях. Нові посилання знову потраплятимуть сюди, доки ви їх не розсортуєте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一切都已归位。新链接在整理之前会再次出现在这里。"
