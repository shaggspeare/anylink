    "Check your connection and try again. It carries on where it stopped." : {
      "comment" : "Upgrade (S20) failed: what to do.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقق من اتصالك وحاول مرة أخرى. سيتابع من حيث توقف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe deine Verbindung und versuch es erneut. Es geht dort weiter, wo es aufgehört hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa tu conexión e inténtalo de nuevo. Seguirá donde se quedó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie ta connexion et réessaie. Ça reprend là où ça s’est arrêté."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Periksa koneksimu lalu coba lagi. Prosesnya berlanjut dari titik terakhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla la connessione e riprova. Riprende da dove si era fermato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続を確認して、もう一度お試しください。止まったところから再開します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결 상태를 확인하고 다시 시도하세요. 멈춘 곳부터 이어서 진행합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź połączenie i spróbuj ponownie. Proces wznowi się tam, gdzie się zatrzymał."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique sua conexão e tente novamente. Ele continua de onde parou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте подключение и попробуйте снова. Процесс продолжится с того места, где остановился."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевірте з’єднання і спробуйте ще раз. Продовжиться з того місця, де зупинилося."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查网络连接后重试。会从中断的地方继续。"
          }
        }
      }
    },
