// Copy to Config.xcconfig (git-ignored) and fill in values for device/live builds.
// `//` starts a comment in xcconfig: write URLs as https:/$()/host, or they arrive as "https:".
ANYLINK_API_BASE = https:/$()/www.anylink.space
SUPABASE_URL =
SUPABASE_ANON_KEY =
DEVELOPMENT_TEAM = 376HNWM383
// DEBUG builds on the simulator, which can't use App Attest, send this instead. It only works against a server whose
// APP_ATTEST_DEV_SECRET matches (never production). Letters and digits only. Leave empty to test the refusal.
APP_ATTEST_DEV_SECRET =
