    "Copied. Now paste it.": {
      "comment": "After tapping an image",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم النسخ. الصقها الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiert. Jetzt einfügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiado. Ahora pégalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copié. Collez-le maintenant."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disalin. Sekarang tempel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiato. Ora incollalo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーしました。貼り付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사했습니다. 이제 붙여넣으세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopiowano. Teraz wklej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiado. Agora cole."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопировано. Теперь вставьте."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопійовано. Тепер вставте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已复制，现在粘贴即可。"
          }
        }
      }
    },
