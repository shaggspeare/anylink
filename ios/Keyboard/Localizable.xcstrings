    "Save a meme or a screenshot in AnyLink and it shows up here.": {
      "comment": "Keyboard empty state",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ ميمًا أو لقطة شاشة في AnyLink وستظهر هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere ein Meme oder einen Screenshot in AnyLink, und es erscheint hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda un meme o una captura en AnyLink y aparecerá aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez un mème ou une capture d'écran dans AnyLink : il apparaîtra ici."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan meme atau tangkapan layar di AnyLink dan akan muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva un meme o uno screenshot in AnyLink e comparirà qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AnyLink にミームやスクリーンショットを保存するとここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AnyLink에 밈이나 스크린샷을 저장하면 여기에 표시됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz mem lub zrzut ekranu w AnyLink, a pojawi się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve um meme ou uma captura de tela no AnyLink e ele aparecerá aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните мем или скриншот в AnyLink, и он появится здесь."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережіть мем або знімок екрана в AnyLink, і він з'явиться тут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 AnyLink 中保存表情包或截图后会显示在这里。"
          }
        }
      }
    },
    "The keyboard needs Full Access to reach your library and the clipboard: Settings → General → Keyboard → Keyboards → AnyLink Memes.": {
      "comment": "Keyboard without Full Access: how to turn it on",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج لوحة المفاتيح إلى الوصول الكامل للوصول إلى مكتبتك والحافظة: الإعدادات → عام → لوحة المفاتيح → لوحات المفاتيح → AnyLink Memes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tastatur braucht Vollzugriff auf deine Mediathek und die Zwischenablage: Einstellungen → Allgemein → Tastatur → Tastaturen → AnyLink Memes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El teclado necesita acceso completo para llegar a tu biblioteca y al portapapeles: Ajustes → General → Teclado → Teclados → AnyLink Memes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clavier a besoin de l'accès complet pour atteindre votre bibliothèque et le presse-papiers : Réglages → Général → Clavier → Claviers → AnyLink Memes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyboard memerlukan Akses Penuh untuk menjangkau pustaka dan papan klip Anda: Pengaturan → Umum → Keyboard → Keyboard → AnyLink Memes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tastiera ha bisogno dell'accesso completo per raggiungere la tua libreria e gli appunti: Impostazioni → Generali → Tastiera → Tastiere → AnyLink Memes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリとクリップボードを使うにはフルアクセスが必要です：設定 → 一般 → キーボード → キーボード → AnyLink Memes。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드가 라이브러리와 클립보드를 사용하려면 전체 접근이 필요합니다: 설정 → 일반 → 키보드 → 키보드 → AnyLink Memes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawiatura potrzebuje pełnego dostępu do Twojej biblioteki i schowka: Ustawienia → Ogólne → Klawiatura → Klawiatury → AnyLink Memes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O teclado precisa de Acesso Total para alcançar sua biblioteca e a área de transferência: Ajustes → Geral → Teclado → Teclados → AnyLink Memes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиатуре нужен полный доступ к вашей библиотеке и буферу обмена: Настройки → Основные → Клавиатура → Клавиатуры → AnyLink Memes."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавіатурі потрібен повний доступ до вашої бібліотеки та буфера обміну: Параметри → Основні → Клавіатура → Клавіатури → AnyLink Memes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘需要完全访问权限才能读取你的资料库和剪贴板：设置 → 通用 → 键盘 → 键盘 → AnyLink Memes。"
          }
        }
      }
    }
  },
  "version": "1.1"
}
