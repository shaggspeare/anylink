            "state": "translated",
            "value": "Kopiuj „%@”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiar \"%@\""
          }
        },
        "ru": {
          "stringUnit": {
