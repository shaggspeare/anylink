{
  "sourceLanguage": "en",
  "strings": {
    "Copy %@": {
      "comment": "Accessibility label of an image tile; %@ is its title",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخ \"%@\""
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ kopieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiar \"%@\""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copier « %@ »"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salin \"%@\""
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia \"%@\""
          }
