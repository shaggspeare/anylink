    "No images yet": {
      "comment": "Empty state title",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد صور بعد"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Bilder"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay imágenes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'images"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada gambar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna immagine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ画像はありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 이미지가 없습니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze obrazów"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma imagem ainda"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображений пока нет"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зображень ще немає"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有图片"
          }
        }
      }
    },
    "Open AnyLink to see your images.": {
      "comment": "Widget before the app has run",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح AnyLink لرؤية صورك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne AnyLink, um deine Bilder zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre AnyLink para ver tus imágenes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez AnyLink pour voir vos images."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka AnyLink untuk melihat gambar Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri AnyLink per vedere le tue immagini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AnyLink を開くと画像が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AnyLink를 열어 이미지를 확인하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz AnyLink, aby zobaczyć swoje obrazy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o AnyLink para ver suas imagens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте AnyLink, чтобы увидеть свои изображения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте AnyLink, щоб побачити свої зображення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 AnyLink 查看你的图片。"
          }
        }
      }
    },
    "Save a meme or a screenshot and it shows up here.": {
      "comment": "Widget empty state",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ ميمًا أو لقطة شاشة وستظهر هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere ein Meme oder einen Screenshot, und es erscheint hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda un meme o una captura y aparecerá aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez un mème ou une capture d'écran : il apparaîtra ici."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan meme atau tangkapan layar dan akan muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva un meme o uno screenshot e comparirà qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミームやスクリーンショットを保存するとここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밈이나 스크린샷을 저장하면 여기에 표시됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz mem lub zrzut ekranu, a pojawi się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve um meme ou uma captura de tela e ele aparecerá aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните мем или скриншот, и он появится здесь."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережіть мем або знімок екрана, і він з'явиться тут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存表情包或截图后会显示在这里。"
          }
        }
      }
    },
    "Tap to copy": {
      "comment": "Widget hint",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط للنسخ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Kopieren tippen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para copiar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toucher pour copier"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk untuk menyalin"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per copiare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップしてコピー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하여 복사"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij, aby skopiować"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para copiar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь, чтобы скопировать"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться, щоб скопіювати"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按复制"
          }
        }
      }
    },
    "Your newest saved images. Tap one to copy it.": {
      "comment": "Widget gallery description",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحدث صورك المحفوظة. اضغط على واحدة لنسخها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine neuesten gesicherten Bilder. Tippe auf eins, um es zu kopieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus últimas imágenes guardadas. Toca una para copiarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos dernières images enregistrées. Touchez-en une pour la copier."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar tersimpan terbaru Anda. Ketuk satu untuk menyalinnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue immagini salvate più recenti. Toccane una per copiarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近保存した画像。タップしてコピー。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 저장한 이미지. 탭하면 복사됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje najnowsze zapisane obrazy. Stuknij, aby skopiować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas imagens salvas mais recentes. Toque em uma para copiá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши новые сохранённые изображения. Коснитесь, чтобы скопировать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші найновіші збережені зображення. Торкніться, щоб скопіювати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你最新保存的图片。点按即可复制。"
          }
        }
      }
    }
  },
  "version": "1.1"
}
